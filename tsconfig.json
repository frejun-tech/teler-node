{
  "compilerOptions": {
    "module": "commonjs",
    "declaration": true,
    "removeComments": false,
    "allowSyntheticDefaultImports": true,
    "esModuleInterop": true,
    "target": "es2017",
    "sourceMap": false,
    "outDir": "./dist",
    "baseUrl": "./",
    "incremental": true,
    "paths": {
      "@/*": ["src/*"],
      "@test/*": ["test/*"]
    },
    "strictNullChecks": true
  },
  "include": ["src/**/*", "test/api/secrets.test.ts"],
  "exclude": ["node_modules", "test", "lib", "**/*spec.ts"]
}